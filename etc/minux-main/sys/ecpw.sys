-- ecpw: encrypting every local account file with the system key.
minux.debug("ecpw:start", "minux")
local KEY_FILE = "/usr/minux-main/config/encr.conf"
local AUTH_DIR = "/usr/local/auth"

local keyfile = fs.open(KEY_FILE, "r")
if keyfile == nil then
  minux.debug("ecpw:no key file", "minux")
  return false
end
local key = tonumber(keyfile.readLine())
keyfile.close()
if key == nil then
  minux.debug("ecpw:invalid key", "minux")
  return false
end

local entries = minux.findEntries(AUTH_DIR, { recursive = true, type = "file", includeHidden = true }) or {}
for _, entry in ipairs(entries) do
  if string.match(entry.path, "%.usr$") then
    local handle = fs.open(entry.path, "r")
    local stored = handle and handle.readLine() or nil
    if handle then handle.close() end
    if type(stored) == "string" and stored ~= "" then
      minux.writetable("/" .. entry.path, { minux.encrypt(stored, key) })
      minux.debug("ecpw:" .. entry.path, "minux")
    end
  end
end
minux.debug("ecpw:done", "minux")
return true
