-- Ctrl+T must not be able to abort the boot or skip the login prompt (an
-- aborted init would drop to an unauthenticated CraftOS shell), so ignore
-- terminate events until the session has been established.
local originalPullEvent = os.pullEvent
os.pullEvent = os.pullEventRaw

local bash     = "/etc/minux-main/workspace/shell.lua"
local oldshell = "/rom/programs/shell.lua"
local crashstage = 0

-- === Visual & animation helpers ===

local SPIN_FRAMES = { "|", "/", "-", "\\" }

local function withColor(color, fn)
  if term.isColor() then term.setTextColor(color) end
  fn()
  if term.isColor() then term.setTextColor(colors.white) end
end

local function fullWidth(char)
  local w = term.getSize()
  return string.rep(char, w)
end

local function centeredLine(text, char, color)
  char = char or "="
  local w = term.getSize()
  local content = " " .. text .. " "
  local pad = math.max(0, w - #content)
  local left  = math.floor(pad / 2)
  local right = pad - left
  withColor(color or colors.white, function()
    print(string.rep(char, left) .. content .. string.rep(char, right))
  end)
end

local function divider(char, color)
  withColor(color or colors.white, function()
    print(fullWidth(char or "-"))
  end)
end

local function spinAt(col, row, count)
  withColor(colors.yellow, function()
    for i = 1, (count or 6) do
      term.setCursorPos(col, row)
      write(SPIN_FRAMES[((i - 1) % #SPIN_FRAMES) + 1])
      os.sleep(0.06)
    end
  end)
end

-- Print a boot status line: "  Label ........ [ value ]"
local function bootLine(label, value, isOk)
  local w = term.getSize()
  local valStr = "[ " .. tostring(value) .. " ]"
  local prefix = "  " .. label
  local dotsLen = math.max(1, w - #prefix - #valStr - 2)
  write(prefix .. " " .. string.rep(".", dotsLen) .. " ")
  withColor(isOk and colors.lime or colors.orange, function()
    print(valStr)
  end)
end

-- === Crash handler ===

local function getCrashHandler(stage)
  local path = "/temp/minux/boot/fail" .. stage .. ".tmp"
  if fs.exists(path) then
    local tempfile = fs.open(path, "r")
    local value = tonumber(tempfile.readLine()) or 0
    tempfile.close()
    return value
  end
  return 0
end

local function setCrashHandler(stage, value)
  local dir = "/temp/minux/boot/"
  if not fs.exists(dir) then fs.makeDir(dir) end
  local tempfile = fs.open(dir .. "fail" .. stage .. ".tmp", "w")
  tempfile.writeLine(value)
  tempfile.close()
end

local function repairShell(stage)
  local stageNumber = tonumber(stage)
  local displayStage = stageNumber or tostring(stage)
  term.clear()
  term.setCursorPos(1, 1)
  divider("!", colors.red)
  if stageNumber == 1 then
    withColor(colors.red, function() print("  KERNEL PANIC") end)
  else
    withColor(colors.red, function()
      print("  ReMinux init failure  (stage " .. tostring(displayStage) .. ")")
    end)
  end
  divider("!", colors.red)
  if _G.version then print("  Version: " .. _G.version) end
  if stageNumber == 4 then
    print("")
    withColor(colors.yellow, function() print("  Possible causes:") end)
    print("    1) UI or boot program is broken")
    print("    2) Computer shut down mid-boot")
    print("    3) Minecraft chunk reloaded")
    print("")
    print("  Disable:  config crashhandler disabled")
  end
  print("")
  withColor(colors.gray, function() write("  Press Enter to open repair shell...") end)
  read()
  setCrashHandler("1", "0")
  shell.run(oldshell)
end

local function checkCrashStage(stage)
  local stageId = tostring(stage)
  local stageNumber = tonumber(stageId)
  crashstage = getCrashHandler(stageId)
  if crashstage >= 2 then
    setCrashHandler(stageId, "0")
    repairShell(stageNumber or stageId)
  else
    setCrashHandler(stageId, tostring(crashstage + 1))
  end
end

-- === Boot sequence ===

centeredLine("ReMinux", "=", colors.cyan)

checkCrashStage("1")

-- Kernel load with brief spinner
write("  Kernel  ")
local kx, kernelRow = term.getCursorPos()
spinAt(kx, kernelRow, 8)

_G.expect = dofile("/rom/modules/main/cc/expect.lua")

-- Load the core APIs. A missing or broken API would otherwise crash every
-- later boot step, so stop here with a clear recovery screen instead.
local function loadCoreApi(path, name)
  if not fs.exists(path) then
    return false, path .. " is missing"
  end
  local ok, result = pcall(os.loadAPI, path)
  if ok ~= true then
    return false, tostring(result)
  end
  if result == false or _G[name] == nil then
    return false, "failed to load " .. path
  end
  return true
end

local coreApis = {
  { path = "/etc/api/minux", name = "minux" },
  { path = "/etc/api/apt", name = "apt" },
}
for _, api in ipairs(coreApis) do
  local loaded, loadErr = loadCoreApi(api.path, api.name)
  if loaded ~= true then
    term.setCursorPos(1, kernelRow)
    term.clearLine()
    bootLine("Kernel", "failed", false)
    print("")
    withColor(colors.red, function() print("  Could not load the " .. api.name .. " API:") end)
    print("  " .. tostring(loadErr))
    print("")
    withColor(colors.yellow, function()
      print("  Reinstall ReMinux with the net-installer, or")
      print("  repair the file from the CraftOS shell.")
    end)
    print("")
    withColor(colors.gray, function() write("  Press Enter to open the CraftOS shell...") end)
    read()
    setCrashHandler("1", "0")
    shell.run(oldshell)
    os.shutdown()
  end
end
-- The legacy menu API is optional; a broken copy must not stop the boot.
if fs.exists("/etc/minux-main/sys/menu.lua") then
  pcall(os.loadAPI, "/etc/minux-main/sys/menu.lua")
end

local dbfile = "/etc/apt/list/minux-main.db"
if fs.exists(dbfile) then
  local versionLine = minux.findline(dbfile, "version=")
  local versionData = versionLine and minux.printline(dbfile, versionLine) or nil
  if type(versionData) == "string" and #versionData > 8 then
    _G.version = string.sub(versionData, 9)
  else
    _G.version = "Unknown"
  end
else
  _G.version = "Cleaninstall"
end

term.setCursorPos(1, kernelRow)
term.clearLine()
bootLine("Kernel", "V:" .. _G.version, true)

-- Aliases
if fs.exists("/boot/alias.ls") then
  local aliasOk = shell.run("/boot/alias.ls")
  bootLine("Aliases", aliasOk and "loaded" or "errors", aliasOk)
else
  bootLine("Aliases", "missing", false)
  minux.debug("/boot/alias.ls not found - core aliases unavailable until APT regenerates it", "minux")
end

-- Sanity check with spinner
local sanityPreRow
do
  write("  Sanity  ")
  local sx, sy = term.getCursorPos()
  sanityPreRow = sy
  spinAt(sx, sy, 4)
end
local sanityOk, sanityErr = pcall(minux.sanitycheck)
term.setCursorPos(1, sanityPreRow)
term.clearLine()
if sanityOk then
  bootLine("Sanity", "cleared", true)
else
  bootLine("Sanity", "problems", false)
  withColor(colors.orange, function() print("  " .. tostring(sanityErr)) end)
  withColor(colors.gray, function() print("  Run 'doctor --repair' once the system is up.") end)
  sleep(2)
end

-- Peripheral detection
_G.modemside = minux.perfind("modem")
bootLine("Modem", _G.modemside, _G.modemside ~= "NONE")
if _G.modemside ~= "NONE" then
  pcall(rednet.open, _G.modemside)
end

_G.diskside = minux.perfind("drive")
bootLine("Diskdrive", _G.diskside, _G.diskside ~= "NONE")

_G.monitorside = minux.perfind("monitor")
bootLine("Monitor", _G.monitorside, _G.monitorside ~= "NONE")
if _G.monitorside ~= "NONE" then
  _G.monitor = peripheral.wrap(_G.monitorside)
end

_G.printerside = minux.perfind("printer")
bootLine("Printer", _G.printerside, _G.printerside ~= "NONE")
if _G.printerside ~= "NONE" then
  _G.printer = peripheral.wrap(_G.printerside)
end

_G.speakerside = minux.perfind("speaker")
bootLine("Speaker", _G.speakerside, _G.speakerside ~= "NONE")

-- Network DHCP
_G.server = "[none]"
if minux.getconfig("network") == "enabled" then
  local _, dhcpRow = term.getCursorPos()
  withColor(colors.gray, function() write("  DHCP  [ connecting ]") end)
  print()
  pcall(shell.run, "/boot/network/dhcp.sys")
  term.setCursorPos(1, dhcpRow)
  term.clearLine()
  local serverFound = _G.server ~= "[none]"
  bootLine("DHCP", serverFound and _G.server or "no server", serverFound)
end

-- System settings
local crashCfg = minux.getconfig("crashhandler")
bootLine("Crashhandler", crashCfg, crashCfg == "enabled")

setCrashHandler("1", "0")
checkCrashStage("2")

_G.debugmode = minux.getconfig("debug")
bootLine("Debug", _G.debugmode, _G.debugmode == "disabled")
minux.debug("Debug system loaded", "minux")

local loginMode = minux.getconfig("login")
bootLine("Login", loginMode, loginMode ~= "disabled")

local uiMode = minux.getconfig("ui")
bootLine("UI", uiMode, true)

local updateMode = minux.getconfig("update")
bootLine("Updates", updateMode, updateMode ~= "disabled")

divider("=", colors.cyan)

-- First-run detection
local firstupdate = false
local firstrunFile = "/usr/minux-main/data/firstrun.db"
if not fs.exists(firstrunFile) then
  firstupdate = true
end

_G.shell = shell

-- Run an optional boot step without letting a failure abort the boot.
local function runBootStep(label, fn, ...)
  local ok, result, detail = pcall(fn, ...)
  if ok ~= true then
    minux.debug(label .. " crashed: " .. tostring(result), "minux")
    withColor(colors.orange, function() print("  " .. label .. " failed: " .. tostring(result)) end)
    return false
  end
  if result == false and detail ~= nil then
    minux.debug(label .. " failed: " .. tostring(detail), "minux")
    withColor(colors.orange, function() print("  " .. label .. ": " .. tostring(detail)) end)
  end
  return result
end

runBootStep("Update check", shell.run, "/boot/network/update.sys")
minux.debug("running early boot services", "minux")
runBootStep("Early services", minux.runServiceTrigger, "boot", "early")

setCrashHandler("2", "0")
checkCrashStage("3")

minux.debug("running override services", "minux")
runBootStep("Override services", minux.runServiceTrigger, "boot", "override")
minux.debug("resetting crash handler stage 3", "minux")
setCrashHandler("3", "0")

if minux.getconfig("crashhandler") == "enabled" then
  checkCrashStage("4")
end

minux.debug("running runonce services", "minux")
runBootStep("Run-once services", minux.runServiceTrigger, "boot", "runonce")

-- Login
minux.debug("checking login settings", "minux")
local loginType = minux.getconfig("login")
if loginType ~= "disabled" then
  if fs.exists("/etc/minux-main/sys/menulogin.sys") and term.isColor() and not turtle then
    minux.debug("running gui login for pc", "minux")
    while _G.validlogin ~= true do
      term.setBackgroundColor(colors.black)
      term.setTextColor(colors.white)
      shell.run("/etc/minux-main/sys/menulogin.sys")
    end
  end
  minux.debug("running login.sh", "minux")
  local loginAttempts = 0
  while _G.validlogin ~= true do
    loginAttempts = loginAttempts + 1
    if loginAttempts > 1 then
      minux.debug("login failed.", "minux")
      withColor(colors.red, function()
        print("Login failed (attempt " .. loginAttempts .. "). Try again.")
      end)
    end
    shell.run("/bin/login.sh")
  end
else
  minux.debug("login disabled", "minux")
  _G.validlogin = true
  _G.admin      = true
  _G.login      = "foo"
  _G.masterpass = "bar"
  runBootStep("Login services", minux.runServiceTrigger, "login")
end

pcall(minux.testcolor)

os.pullEvent = originalPullEvent

-- First-run post-install verification
if firstupdate then
  term.clear()
  term.setCursorPos(1, 1)
  centeredLine("First Run Setup", "=", colors.cyan)
  print("")

  local vrRow
  do
    write("  Verifying installation  ")
    local vx, vy = term.getCursorPos()
    vrRow = vy
    spinAt(vx, vy, 8)
  end

  local verifyOk, verifyReturn = pcall(apt.postinstall)
  local verifyError, verifyErrorAction
  if verifyOk ~= true then
    verifyError = verifyReturn
    verifyErrorAction = "raised"
    minux.debug("firstrun:apt.postinstall crashed: " .. tostring(verifyReturn), "minux")
  elseif verifyReturn ~= true then
    verifyError = verifyReturn
    verifyErrorAction = "returned"
    minux.debug("firstrun:apt.postinstall returned: " .. tostring(verifyReturn), "minux")
  end
  local verifyResult = verifyOk and verifyReturn == true

  term.setCursorPos(1, vrRow)
  term.clearLine()
  bootLine("Verification", verifyResult and "passed" or "failed", verifyResult)

  local firstrunMarked = false
  local firstrunDir = fs.getDir(firstrunFile)
  if firstrunDir ~= "" and not fs.exists(firstrunDir) then
    local ok2, err2 = pcall(fs.makeDir, firstrunDir)
    if not ok2 then
      minux.debug("firstrun:mkdir failed: " .. firstrunDir .. ": " .. tostring(err2), "minux")
    end
    if not fs.exists(firstrunDir) then
      minux.debug("firstrun:mkdir left path missing: " .. firstrunDir, "minux")
    end
  end
  local tmpfile = fs.open(firstrunFile, "w")
  if tmpfile ~= nil then
    tmpfile.writeLine("done")
    tmpfile.close()
    firstrunMarked = true
  else
    minux.debug("firstrun:write failed: " .. firstrunFile, "minux")
  end

  if verifyResult then
    if not firstrunMarked then
      minux.debug("firstrun verification succeeded but marker write failed", "minux")
      withColor(colors.yellow, function()
        print("  Warning: could not record first-run marker.")
        print("  Continuing without rebooting.")
      end)
      sleep(3)
    else
      withColor(colors.lime, function() print("  Installation verified! Rebooting...") end)
      os.sleep(0.8)
      os.reboot()
    end
  else
    withColor(colors.red, function() print("  Post-install verification failed.") end)
    if verifyError ~= nil then
      print("  apt postinstall " .. verifyErrorAction .. ": " .. tostring(verifyError))
    end
    if not firstrunMarked then
      withColor(colors.yellow, function()
        print("  Warning: could not record first-run marker at " .. firstrunFile .. ".")
      end)
    end
    print("  Run 'apt -U' or 'doctor --repair' to fix.")
    withColor(colors.gray, function() print("  Continuing in 3 seconds...") end)
    sleep(3)
  end
end

-- Welcome prompt
local w = term.getSize()
local BOOT_PROMPT_TIMEOUT = 10
withColor(colors.cyan, function() print(string.rep("=", w)) end)

print(" Welcome to ReMinux " .. tostring(_G.version) .. "!")
withColor(colors.gray, function()
  if w >= 51 then
    print(" [Enter] continue  [bash] shell  [help] more")
  else
    print(" [Enter] start  [help] more")
  end
  print(" Continuing automatically in " .. BOOT_PROMPT_TIMEOUT .. "s...")
end)

withColor(colors.cyan, function() print(string.rep("=", w)) end)

-- Wait for input, but continue on our own if nobody is at the keyboard so
-- unattended computers (servers, turtles) still come up after a restart.
-- Once a key is pressed the prompt waits as long as needed.
local function readBootPrompt()
  local input
  parallel.waitForAny(function()
    input = read()
  end, function()
    local timer = os.startTimer(BOOT_PROMPT_TIMEOUT)
    while true do
      local event, value = os.pullEvent()
      if event == "timer" and value == timer then
        return
      elseif event == "char" or event == "key" or event == "paste" then
        while true do os.pullEvent("reminux_never") end
      end
    end
  end)
  if input == nil then print("") end
  return input
end

local initput = readBootPrompt()
while initput ~= nil do
  if initput == "bash" then
    minux.debug("launching prompt", "minux")
    shell.run(bash)
    initput = read()
  elseif initput == "update" then
    write("  Updating packages... ")
    local updateOk, updateResult = pcall(apt.update, "-f")
    if updateOk and updateResult == true then
      withColor(colors.lime, function() print("done") end)
    else
      withColor(colors.red, function()
        print("failed (" .. tostring(updateResult) .. ")")
      end)
    end
    initput = read()
  elseif initput == "reboot" or initput == "restart" then
    shell.run("/bin/restart.sh")
    initput = read()
  elseif initput == "halt" or initput == "shutdown" then
    shell.run("/bin/halt.sh")
    initput = read()
  elseif initput == "help" or initput == "?" then
    print("")
    withColor(colors.cyan, function() print("Available commands:") end)
    print("  bash                  launch the ReMinux shell")
    print("  update                refresh APT packages now")
    print("  restart / reboot      reboot the computer")
    print("  halt / shutdown       shut the computer down")
    print("  help / ?              show this message")
    print("")
    withColor(colors.gray, function() print("Press Enter to continue to the configured UI.") end)
    initput = read()
  elseif initput == "" then
    initput = nil
  else
    withColor(colors.orange, function()
      print("Unknown command '" .. initput .. "'. Type 'help' or press Enter.")
    end)
    initput = read()
  end
end

-- Launch configured UI
local menuchoice = minux.getconfig("ui")
local uiProgram, uiArgs = bash, {}
if menuchoice == "menu" and fs.exists("/bin/minux.sh") then
  uiProgram = "/bin/minux.sh"
elseif menuchoice == "craftos" then
  uiProgram = oldshell
elseif menuchoice == "workspace" then
  uiProgram = "/bin/workspace.sh"
end
minux.debug("launching " .. tostring(menuchoice) .. ": " .. uiProgram, "minux")

-- Once the UI has stayed up for a while the boot counts as successful, so
-- a later chunk unload or power loss does not trip the crash handler.
local HEALTHY_AFTER_SECONDS = 20
local uiOk, uiErr
parallel.waitForAny(function()
  uiOk, uiErr = pcall(shell.run, uiProgram, table.unpack(uiArgs))
end, function()
  -- Raw events: Ctrl+T is meant for the UI and must not kill this watcher.
  local timer = os.startTimer(HEALTHY_AFTER_SECONDS)
  repeat
    local _, id = os.pullEventRaw("timer")
  until id == timer
  minux.markBootHealthy()
  while true do os.pullEventRaw("reminux_never") end
end)

if uiOk ~= true then
  term.redirect(term.native())
  term.setBackgroundColor(colors.black)
  term.setTextColor(colors.white)
  term.clear()
  term.setCursorPos(1, 1)
  divider("!", colors.red)
  withColor(colors.red, function() print("  The user interface crashed:") end)
  divider("!", colors.red)
  print("  " .. tostring(uiErr))
  print("")
  withColor(colors.gray, function()
    print("  Try 'config ui prompt' or 'doctor --repair'.")
    write("  Press Enter to reboot...")
  end)
  read()
end

minux.debug("UI exited, restarting", "minux")
minux.restart()
